# Skylark v2.36.1 production image
SLP_VERSION=2.36.1-3d98cb1948
# Override this only when the selected Skylark image supports another platform.
SLP_PLATFORM=linux/amd64
# Host access to the RustFS API and console. Nginx uses the internal network.
RUSTFS_BIND_ADDRESS=127.0.0.1
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
