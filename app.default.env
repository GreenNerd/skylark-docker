# [Nginx]
NGINX_SERVER_NAME=_
NGINX_SERVER_PROTO=http
NGINX_SSL_CIPHERS=

# [Application]
RAILS_HEADER_X_FRAME_OPTIONS=SAMEORIGIN

# [Common]
RAILS_ENV=production
NODE_ENV=production

# [Postgres]
POSTGRES_POOL=128
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432


# [Settings]
SETTING_ROOT_IDS=[]

SETTING_WECHAT_COMPONENT_APPID=
SETTING_WECHAT_COMPONENT_APPSECRET=
SETTING_WECHAT_COMPONENT_ENCODING_AES_YEY=
SETTING_WECHAT_COMPONENT_AUTHORIZATION_CALLBACK_URL=
SETTING_WECHAT_COMPONENT_TOKEN=

SETTING_QINIU_DISABLE_AUTHORIZATION=false
SETTING_QINIU_BUCKET=
SETTING_QINIU_UPLOAD_URL=
SETTING_QINIU_DOMAIN=
SETTING_QINIU_ACCESS_KEY=
SETTING_QINIU_SECRET_KEY=
SETTING_QINIU_ATTACHMENT_BUCKET=
SETTING_QINIU_ATTACHMENT_DOMAIN=
SETTING_QINIU_ATTACHMENT_SIZE=10
SETTING_QINIU_EXPORTABLE_FILE_BUCKET=
SETTING_QINIU_EXPORTABLE_FILE_DOMAIN=
SETTING_QINIU_MATERIAL_IMAGE_BUCKET=
SETTING_QINIU_MATERIAL_IMAGE_DOMAIN=
SETTING_QINIU_MATERIAL_IMAGE_SIZE=10

SETTING_YUNPIAN_API_KEY=
SETTING_YUNPIAN_TPL_ID=
SETTING_YUNPIAN_INVOLVED_TPL_ID=
SETTING_YUNPIAN_TPL_ID_WITH_SHORT_URL=
SETTING_YUNPIAN_VERIFY_CODE_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_COMMENT_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_RESPONSE_CREATED_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_RESPONSE_UPDATED_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_RESPONSE_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_ORGANIZATION_APPLICATION_TPL_ID=
SETTING_YUNPIAN_SUBSCRIPTION_BUNCH_TPL_ID=

SETTING_RESPONSE_ASYNC_EXPORT_MIN=100
SETTING_RESPONSE_FILE_EXPIRED_MINUTES=10

SETTING_MEMBER_ASYNC_IMPORT_MIN=100

SETTING_ATTACHMENTS_DOWNLOAD_EXPIRED_MINUTES=10

SETTING_APP_DOMAIN=https://skylarkly.com
SETTING_APP_IP=
SETTING_APP_CMS_CACHE_EXPIRED_HOURS=12
SETTING_APP_DEFAULT_SITE_NAME=Skylark
SETTING_APP_MAX_SIDEKIQ_USAGE=50
SETTING_APP_ASSET_HOST=
SETTING_APP_SENTRY_DSN=
SETTING_APP_SENTRY_RUBY_DSN=
SETTING_APP_SMS_PRIVODER=
SETTING_APP_SMS_SERVICE=
SETTING_WELCOME_PAGE=
SETTING_APP_BEIAN_CODE=
SETTING_APP_BEIAN_REGISTER_TIPS=
SETTING_APP_USER_AGENT_FOR_MOBILE=
SETTING_APP_TOS_URL=
SETTING_APP_SMS_MINUTE_LIMIT=

SETTING_EXPORTABLE_FILE_MAX_CELLS=100
SETTING_EXPORTABLE_FILE_EXPIRED_MINUTES=10

SETTING_AMAP_JS_KEY=
SETTING_AMAP_WEB_KEY=

SETTING_ALIYUN_ACCESS_KEY_ID=
SETTING_ALIYUN_ACCESS_KEY_SECRET=
SETTING_ALIYUN_CALLED_SHOW_NUMBER=
SETTING_ALIYUN_TTS_CODES_MESSAGE=
SETTING_ALIYUN_TTS_CODES_COMMENT=
SETTING_ALIYUN_TTS_CODES_ORGANIZATION_APPLICATION=
SETTING_ALIYUN_TTS_CODES_RESPONSE_CREATED=
SETTING_ALIYUN_TTS_CODES_RESPONSE_UPDATED=
SETTING_ALIYUN_SMS_SIGN_NAME=
SETTING_ALIYUN_IP_LIMIT_PER_DAY=
SETTING_ALIYUN_WITH_PRODUCT_VAR=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_VERIFY_CODE=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_MESSAGE_UNREAD=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_MESSAGE_UNREAD_WITH_URL=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_MESSAGE_INVOLVED=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_SUBSCRIPTION_COMMENT=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_SUBSCRIPTION_RESPONSE_CREATED=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_SUBSCRIPTION_RESPONSE_UPDATED=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_SUBSCRIPTION_ORGANIZATION_APPLICATION=
SETTING_ALIYUN_SMS_TEMPLATE_CODE_SUBSCRIPTION_BUNCH=

SETTING_JWT_LAS_VEGAS=

SETTING_JUHE_API_BASE=http://v.juhe.cn/calendar/year
SETTING_JUHE_KEY=

# [Cable]
CABLE_REDIS_URL=redis://redis:6379/14
CABLE_ALLOWED_ORIGINS=

# [Chewy]
CHEWY_HOST=elasticsearch:9200

# [Puma] 镜像内 config/puma.rb 读取这些键；旧 PUMA_* 已被忽略
RAILS_MAX_THREADS=32
RAILS_MIN_THREADS=32
WEB_CONCURRENCY=2
WEB_WORKER_TIMEOUT=60
PORT=3000
PIDFILE=/var/www/pids/puma.pid
BIND_HOST=0.0.0.0

# [Redis]
REDIS_HOST=redis
REDIS_PORT=6379

# [Secrets]
# 在 app.local.env 设置部署专用值。升级时保留当前使用的密钥。
SECRET_KEY_BASE=

# [Sidekiq]
SIDEKIQ_CONCURRENCY=20

# [Skylight]
SKYLIGHT_AUTHENTICATION=
SKYLIGHT_ENABLED=false
SKYLIGHT_ENV=production

# [Gxcloud]
SETTING_GXCLOUD_ENABLE=

# [LogLevel]
RAILS_LOG_LEVEL=info

# [Chuangli]
SETTING_CHUANGLI_APPID=
SETTING_CHUANGLI_SECRET=

# [Storage] Skylark 的 S3 后端仍使用 minio 标识和 SETTING_MINIO_* 配置。
SETTING_STORAGE_WRITE=minio
SETTING_MINIO_ENDPOINT=http://rustfs:9000
SETTING_MINIO_PUBLIC_ENDPOINT=
SETTING_MINIO_ACCESS_KEY=
SETTING_MINIO_SECRET_KEY=
SETTING_MINIO_REGION=us-east-1
SETTING_MINIO_FORCE_PATH_STYLE=true
SETTING_MINIO_IMGPROXY_URL=
SETTING_MINIO_BUCKET_MAIN=slp-main
SETTING_MINIO_BUCKET_ATTACHMENT=slp-attachment
SETTING_MINIO_BUCKET_EXPORTABLE_FILE=slp-exportable
SETTING_MINIO_BUCKET_MATERIAL=slp-material

# [Third-party messages]
THIRD_PARTY_MESSAGE_URL=

# [V4 login]
SETTING_V4_LOGIN_ENABLE=
SETTING_V4_LOGIN_SECRET=
