# [Cable]
CABLE_REDIS_URL=redis://redis:6379/14

# [Chewy]
CHEWY_HOST=elasticsearch:9200

# [Puma] 镜像内 config/puma.rb 读取这些键；旧 PUMA_* 已被忽略
RAILS_MAX_THREADS=32
RAILS_MIN_THREADS=32
WEB_CONCURRENCY=2
WEB_WORKER_TIMEOUT=60
PORT=3000
PIDFILE=/var/www/pids/puma.pid
BIND_HOST=0.0.0.0

# [Redis]
REDIS_HOST=redis
REDIS_PORT=6379

# [Secrets]
# Rails 7.2+ 读取 SECRET_KEY_BASE；与 SECRETS_KEY_BASE 保持同值
SECRETS_KEY_BASE=d061dcb4fd4ffc4f3063834879620754cf2110716d0694835c93d3b52cc44e2f3eac5ced27be9c600d1a6408bfd47204f7bc3204f1c6d64dc1313b437005c097
SECRET_KEY_BASE=

# [Sidekiq]
SIDEKIQ_CONCURRENCY=20

# [Skylight]
SKYLIGHT_AUTHENTICATION=
SKYLIGHT_ENABLED=false
SKYLIGHT_ENV=production

# [TableMapper]
SETTING_TABLE_MAPPER_MAPPER_URL=
SETTING_TABLE_MAPPER_RESET_URL=

# [DataOS]
SETTING_DATAOS_ENABLE=
SETTING_DATAOS_DOMAIN=
SETTING_DATAOS_KEY=

# [Gxcloud]
SETTING_GXCLOUD_ENABLE=

# [LogLevel]
RAILS_LOG_LEVEL=info

# [Chuangli]
SETTING_CHUANGLI_APPID=
SETTING_CHUANGLI_SECRET=

# [Storage] 新环境默认七牛；MinIO 就绪后在 app.local.env 切 SETTING_STORAGE_WRITE=minio
SETTING_STORAGE_WRITE=qiniu
SETTING_MINIO_ENDPOINT=http://minio:9000
SETTING_MINIO_PUBLIC_ENDPOINT=
SETTING_MINIO_ACCESS_KEY=
SETTING_MINIO_SECRET_KEY=
SETTING_MINIO_REGION=us-east-1
SETTING_MINIO_FORCE_PATH_STYLE=true
SETTING_MINIO_IMGPROXY_URL=
SETTING_MINIO_BUCKET_MAIN=slp-main
SETTING_MINIO_BUCKET_ATTACHMENT=slp-attachment
