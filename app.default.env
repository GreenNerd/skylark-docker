# [YARN]
SASS_BINARY_SITE=https://npm.taobao.org/mirrors/node-sass/

# [Elasticsearch]
ES_JAVA_OPTS=-Xms2g -Xmx2g

# [Nginx]
NGINX_SERVER_NAME=
NGINX_SERVER_PROTO=http
NGINX_SSL_CIPHERS=

# [Application]
RAILS_HEADER_X_FRAME_OPTIONS=SAMEORIGIN
# 2.34+ 镜像改用 Redis cache，不再使用 memcached。旧镜像若仍读取此键可留空。
RAILS_CACHE_STORE_URL=

# [Common]
RAILS_ENV=production
NODE_ENV=production

# [Postgres]
POSTGRES_POOL=128
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432


